          "deviceId",
          "backend",
          "success",
          "durationMs",
          "state",
          "data",
          "error"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "backend": {
            "type": "string",
            "nullable": true
          },
          "success": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled",
              "unknown"
            ]
          },
          "data": {
            "nullable": true,
            "description": "操作特定对象或数组；截图含PNG的imageBase64无损封装"

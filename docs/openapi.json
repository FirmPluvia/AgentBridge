{
  "openapi": "3.0.3",
  "info": {
    "title": "AgentBridge Execution API",
    "version": "1.0.0",
    "description": "直连前缀/api/v1；中转使用/devices/{deviceId}/api/v1。所有副作用禁止自动重试，先查询任务。PNG为Base64封装。"
  },
  "servers": [
    {
      "url": "https://phone.example:8443"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "status",
        "summary": "读取真实设备及后端状态",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "检查success/error/state，HTTP200不表示操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "401": {
            "description": "未授权或撤销"
          },
          "413": {
            "description": "请求超过64KiB"
          }
        },
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "description": "去重ID，UUID；未知结果不得新建ID重试副作用"
            }
          },
          {
            "name": "deviceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "副作用串行占用会话"
            }
          },
          {
            "name": "deadline",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "Unix毫秒，最多未来120秒"
            }
          }
        ]
      }
    },
